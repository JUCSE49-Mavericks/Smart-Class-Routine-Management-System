{
    "cancelScheduledClass": [
      {
        "description": "Should cancel the class successfully",
        "scheduled_class_id": 1,
        "dbResponse": { "affectedRows": 1 },
        "expectedStatus": 200,
        "expectedMessage": "Class canceled successfully"
      },
      {
        "description": "Should return 404 if class not found or already canceled",
        "scheduled_class_id": 2,
        "dbResponse": { "affectedRows": 0 },
        "expectedStatus": 404,
        "expectedMessage": "No class found to confirm"
      },
      {
        "description": "Should return 500 on database error",
        "scheduled_class_id": 3,
        "dbError": { "message": "Database error" },
        "expectedStatus": 500,
        "expectedMessage": "Failed to cancel class"
      }
    ]
  }
  